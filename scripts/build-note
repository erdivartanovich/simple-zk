#!/usr/bin/env bash
# build-note — notebook-wide PDF builds for zk notes, layered on docwrite.
#
# Per-file build/open is done by docwrite/docread (generic, in the dotfiles'
# ~/.config/scripts, on $PATH). This adds only the note-scoped bulk operations;
# the cache layout and mapping are docwrite's (see `docwrite --path`).
#
#   build-note --all [--force]  build every note (parallel; skips up-to-date)
#   build-note --prune          drop cache PDFs whose note no longer exists
#   build-note --all --prune    reconcile the cache with the notebook
#
# Env: NOTES_DIR (notebook root, def ~/Cabin/org/zettels); DOC_* honored by docwrite.

set -euo pipefail

force=0 all=0 prune=0
while [ $# -gt 0 ]; do
	case "$1" in
	--force) force=1 ;;
	--all)   all=1 ;;
	--prune) prune=1 ;;
	*) printf 'build-note: unexpected argument %s\n' "$1" >&2; exit 2 ;;
	esac
	shift
done
[ "$all" = 1 ] || [ "$prune" = 1 ] || {
	echo "build-note: use --all and/or --prune (per-file: docwrite / docread)" >&2
	exit 2
}

command -v docwrite >/dev/null 2>&1 || { echo "build-note: docwrite not found on PATH" >&2; exit 1; }

NOTES_DIR="${NOTES_DIR:-$HOME/Cabin/org/zettels}"
notes_root="$(realpath -m -- "$NOTES_DIR")"
CACHE="${DOC_BUILD_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/docbuilds}"

find_notes() { # NUL-delimited note files, skipping hidden dirs (.zk, .zk_bak, .git…)
	find "$notes_root" -type d -name '.*' -prune -o -type f -name '*.md' -print0
}

if [ "$all" = 1 ]; then
	count="$(find "$notes_root" -type d -name '.*' -prune -o -type f -name '*.md' -printf 'x' | wc -c)"
	printf 'build-note: building %s note(s) under %s ...\n' "$count" "$notes_root"
	cmd=(docwrite)
	[ "$force" = 1 ] && cmd+=(--force)
	find_notes | xargs -0 -r -P "$(nproc 2>/dev/null || echo 4)" -n1 "${cmd[@]}" || true
	printf 'build-note: done\n'
fi

if [ "$prune" = 1 ]; then
	sub="$CACHE/${notes_root#/}" # cache subtree mirroring this notebook
	n=0
	if [ -d "$sub" ]; then
		# keep = the PDFs the current notes map to (via docwrite's own mapping)
		declare -A keep=()
		while IFS= read -r -d '' f; do keep["$(docwrite --path "$f")"]=1; done < <(find_notes)
		while IFS= read -r -d '' pf; do
			[ -n "${keep[$pf]:-}" ] || { rm -f -- "$pf"; n=$((n + 1)); }
		done < <(find "$sub" -type f -name '*.pdf' -print0)
		find "$sub" -type d -empty -delete 2>/dev/null || true
	fi
	printf 'build-note: pruned %d orphaned PDF(s)\n' "$n"
fi
exit 0
